<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>WeazelBioGenerator</defName>
        <label>위젤 생체 발전기</label>
        <description>G.A.M의 생체 발열을 응용하여 전력을 생산하는 발전기입니다. 전력을 생산하는데 G.A.M을 요구합니다.\n\n G.A.M은 위젤 사회에서 널리 사용되는 물질입니다. 특히, 이런 전력 생산 시설에도 사용되곤 합니다. G.A.M을 가학적으로 자극하면 발열과 약간의 전력을 생산한다는 원리를 발견한지 얼마되지않아, 위젤 대부분의 약탈 기지에는 화학 연료 대신 G.A.M을 이용한 전력 확보가 활발하게 사용되고 있습니다. 애초에 위젤이 약탈을 위한 기지를 만든다는 것은 에센스를 추출한다는 의미이며, 에센스만 있다면 G.A.M 배양은 아주 빠르기 때문에 자체적으로 전력을 확보할 수 있다는 큰 장점을 가지고 있습니다.</description>
        <researchPrerequisites><li>WeazelBioGenerator</li></researchPrerequisites>
        <thingClass>Building</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>Things/Building/Bio_Generator/Bio_Generator</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(1.75,2.82)</drawSize>
            <drawOffset>(0,0,0.5)</drawOffset>
        </graphicData>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <fillPercent>0.9</fillPercent>
        <pathCost>50</pathCost>
        <rotatable>false</rotatable>
        <blockWind>true</blockWind>
        <statBases>
        <MaxHitPoints>300</MaxHitPoints>
        <WorkToBuild>2500</WorkToBuild>
        <Flammability>1.0</Flammability>
        <Beauty>-20</Beauty>
        </statBases>
        <tickerType>Normal</tickerType>
        <canOverlapZones>false</canOverlapZones>
        <size>(2,2)</size>
        <uiIconScale>0.85</uiIconScale>
        <building>
            <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
        </building>
        <costList>
            <Steel>225</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
            <Weazel_GAM>60</Weazel_GAM>
        </costList>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerPlant</compClass>
                <basePowerConsumption>-1500</basePowerConsumption>
                <transmitsPower>true</transmitsPower>
                <soundAmbientProducingPower>ChemfuelFiredGenerator_Ambience</soundAmbientProducingPower>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Refuelable">
                <fuelConsumptionRate>0.45</fuelConsumptionRate>
                <fuelCapacity>30.0</fuelCapacity>
                <fuelFilter>
                    <thingDefs>
                        <li>Weazel_GAM</li>
                    </thingDefs>
                </fuelFilter>
                <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
                <canEjectFuel>true</canEjectFuel>
            </li>
            <li Class="CompProperties_Glower">
                <glowRadius>6</glowRadius>
                <glowColor>(80,112,180,0)</glowColor>
            </li>
            <li Class="CompProperties_HeatPusher">
                <compClass>CompHeatPusherPowered</compClass>
                <heatPerSecond>6</heatPerSecond>
            </li>
            <li Class="CompProperties_Breakdownable"/>
            <li Class="CompProperties_Explosive">
                <explosiveRadius>0</explosiveRadius>
                <explosiveExpandPerFuel>0.95</explosiveExpandPerFuel>
                <explosiveDamageType>Flame</explosiveDamageType>
                <destroyThingOnExplosionSize>2</destroyThingOnExplosionSize>
                <startWickHitPointsPercent>0.333</startWickHitPointsPercent>
                <preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
                <preExplosionSpawnChance>1</preExplosionSpawnChance>
                <wickTicks>70~150</wickTicks>
            </li>
            <li Class="CompProperties_Stunnable">
                <useLargeEMPEffecter>true</useLargeEMPEffecter>
                <affectedDamageDefs>
                    <li>EMP</li>
                </affectedDamageDefs>
            </li>
        </comps>
        <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
        <designationCategory>Power</designationCategory>
        <uiOrder>2100</uiOrder>
        <designationHotKey>Misc4</designationHotKey>
        <constructEffect>ConstructMetal</constructEffect>
        <researchPrerequisites>
            <li>Electricity</li>
        </researchPrerequisites>
        <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    </ThingDef>
</Defs>