<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ResearchTabDef>
        <defName>WeazelTech</defName>
        <label>위젤 기술</label>
    </ResearchTabDef>

    <!-- Column 1 -->

    <!-- 에센스 방직기 -->
    <ResearchProjectDef>
        <defName>WeazelEssenceWeaver</defName>
        <label>에센스 가공</label>
        <description>기초적인 에센스 가공 방식입니다. 에센스를 에센스 실크로 가공할 수 있습니다.</description>
        <tab>WeazelTech</tab>
        <baseCost>500</baseCost>
        <techLevel>Industrial</techLevel>
        <!--
        <prerequisites>
            <li>ComplexFurniture</li>
        </prerequisites>
        -->
        <researchViewX>0</researchViewX>
        <researchViewY>1</researchViewY>
    </ResearchProjectDef>

    <!-- 수감자용 슈트 -->
    <ResearchProjectDef>
        <defName>WeazelWeazelSlavesuit</defName>
        <label>효율적인 가축화</label>
        <description>수감자에게서 주기적으로 에센스를 추출할 수 있는 특수 수감복을 연구합니다.</description>
        <tab>WeazelTech</tab>
        <baseCost>500</baseCost>
        <techLevel>Industrial</techLevel>
        <!--
        <prerequisites>
            <li>ComplexFurniture</li>
        </prerequisites>
        -->
        <researchViewX>0</researchViewX>
        <researchViewY>2.0</researchViewY>
    </ResearchProjectDef>

    <!-- Column 2 -->

    <!-- GAM 배양기 -->
    <ResearchProjectDef>
        <defName>WeazelGAMIncubation</defName>
        <label>G.A.M. 배양 이론</label>
        <description>에센스를 이용해 인공 근육 G.A.M을 배양하는 배양기를 연구합니다.</description>
        <tab>WeazelTech</tab>
        <baseCost>1000</baseCost>
        <techLevel>Industrial</techLevel>
        <prerequisites>
            <li>WeazelEssenceWeaver</li>
        </prerequisites>
        <researchViewX>1</researchViewX>
        <researchViewY>1</researchViewY>
    </ResearchProjectDef>

    <!-- 에센스 정제기 -->
    <ResearchProjectDef>
        <defName>WeazelEssenceRefiner</defName>
        <label>에센스 정제기술</label>
        <description>에센스를 정재하는 정재기를 해금합니다. 아직까진 아무 효과가 없습니다.</description>
        <tab>WeazelTech</tab>
        <baseCost>1000</baseCost>
        <techLevel>Industrial</techLevel>
        <prerequisites>
            <li>WeazelEssenceWeaver</li>
        </prerequisites>
        <researchViewX>1</researchViewX>
        <researchViewY>2</researchViewY>
    </ResearchProjectDef>

    <!-- Column 3 -->

    <!-- 파워아머  -->
    <ResearchProjectDef>
        <defName>WeazelPowerArmor</defName>
        <label>인공 근섬유 재현</label>
        <description>G.A.M을 이용해 파워 아머를 제작할 수 있는 연구를 합니다.</description>
        <tab>WeazelTech</tab>
        <baseCost>3500</baseCost>
        <techLevel>Spacer</techLevel>
        <prerequisites>
            <li>Fabrication</li>
            <li>WeazelGAMIncubation</li>
        </prerequisites>
        <researchViewX>2</researchViewX>
        <researchViewY>0</researchViewY>
    </ResearchProjectDef>

    <!-- 생체 발전기 -->
    <ResearchProjectDef>
        <defName>WeazelBioGenerator</defName>
        <label>인공 생체 응용</label>
        <description>G.A.M을 이용해 발전하는 생체 발전기를 연구합니다.</description>
        <tab>WeazelTech</tab>
        <baseCost>2500</baseCost>
        <techLevel>Spacer</techLevel>
        <prerequisites>
            <li>Electricity</li>
            <li>WeazelGAMIncubation</li>
        </prerequisites>
        <researchViewX>2</researchViewX>
        <researchViewY>1</researchViewY>
    </ResearchProjectDef>

    <!-- Column 3 -->

    <!-- 파워웨폰  -->
    <ResearchProjectDef>
        <defName>WeazelPowerWeapon</defName>
        <label>무장 거대화</label>
        <description>파워 아머만이 들 수 있는 거대 중화기를 연구합니다.</description>
        <tab>WeazelTech</tab>
        <baseCost>1500</baseCost>
        <techLevel>Spacer</techLevel>
        <prerequisites>
            <li>PrecisionRifling</li>
            <li>WeazelPowerArmor</li>
        </prerequisites>
        <researchViewX>3</researchViewX>
        <researchViewY>0</researchViewY>
    </ResearchProjectDef>
</Defs>